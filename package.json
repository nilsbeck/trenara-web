{
	"name": "trenara-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build --mode production",
		"check:bundle": "bun scripts/check-bundle.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:coverage:open": "vitest run --coverage && open coverage/index.html"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "26.4.0",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"@vitest/coverage-v8": "^4.1.12",
		"@vitest/ui": "^4.1.12",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-eslint-parser": "^1.10.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.118.0",
		"@tailwindcss/vite": "^4.3.3",
		"@vercel/functions": "^3.10.3",
		"@vercel/speed-insights": "^2.0.0",
		"dompurify": "^3.4.17",
		"lucide-svelte": "^1.0.1",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
