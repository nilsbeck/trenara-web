BASIC_BEARER_TOKEN=your_trenara_basic_auth_token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional. The Trenara user id allowed to see the rate-limit diagnostic on the
# error page. Unset, the snapshot is server-log only — it names upstream
# endpoints and the serverless instance, which is a maintenance tool rather
# than something to show whoever happened to trip a 429.
ADMIN_USER_ID=
